# Copy to .env for `npm run dev`. Everything has a working local default.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

DATABASE_URL=postgres://hf:hf@localhost:5432/hireflow
# Leave unset for in-memory cache/sessions/pub-sub (single instance only)
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me   # required in production, 16+ chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14

# First admin account, created (or promoted) on startup
ADMIN_EMAIL=admin@hireflow.dev
ADMIN_PASSWORD=password123

# AI scoring. Without a key, a transparent keyword-overlap scorer is used and labelled as such.
# SCORING_PROVIDER=auto          # auto = first key found: Claude, Gemini, OpenAI. Or anthropic | gemini | openai | heuristic
# Google Gemini: free key at https://aistudio.google.com → Get API key (free tier has rate limits)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash    # any Gemini model your key can use
GEMINI_TIMEOUT_MS=60000
ANTHROPIC_API_KEY=               # Claude: get a key at https://platform.claude.com
ANTHROPIC_MODEL=claude-sonnet-5-5  # or claude-haiku-5-5 (cheaper, faster) / claude-opus-5-5
ANTHROPIC_EFFORT=medium          # low | medium | high (thinking effort; higher = slower, more tokens)
# ANTHROPIC_BASE_URL=            # gateway / proxy
ANTHROPIC_TIMEOUT_MS=60000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini        # any Chat Completions model that supports structured outputs
# OPENAI_BASE_URL=               # Azure OpenAI / compatible gateway
OPENAI_TIMEOUT_MS=45000
SCORING_MAX_ATTEMPTS=3
SCORING_POLL_MS=2000

# Resume storage: "local" (disk, used by the Docker demo) or "s3" (AWS S3, Cloudflare R2, or GCS via its S3 XML API + HMAC keys)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
# S3_BUCKET=hireflow-resumes
# S3_REGION=us-east-1
# S3_ENDPOINT=https://storage.googleapis.com
# S3_PUBLIC_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_RESUME_MB=5

# Email alerts. Without SMTP_HOST, emails are recorded in the email log but not sent.
# SMTP_HOST=localhost
# SMTP_PORT=1025
EMAIL_FROM=HireFlow <no-reply@hireflow.local>
